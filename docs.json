            "tab": "API reference",
            "icon": "code",
            "groups": [
              {
                "group": "Using the API",
                "pages": [
                  "en/api-reference/index",
                  "en/playground"
                ]
              },
              {
                "group": "Text",
                "pages": [
                  "en/api-reference/chat-completions",
                  "en/api-reference/completions",
                  "en/api-reference/embeddings"
                ]
              },
              {
                "group": "Images",
                "pages": [
                  "en/api-reference/images",
                  "en/api-reference/images-edits"
                ]
              },
              {
                "group": "Audio",
                "pages": [
                  "en/api-reference/audio-speech",
                  "en/api-reference/audio-transcriptions",
                  "en/api-reference/audio-translations"
                ]
              },
              {
                "group": "Models and extensions",
                "pages": [
                  "en/api-reference/models",
                  "en/api-reference/catalog"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": [
        "bash",
        "python",
        "javascript"
      ],
      "defaults": "required",
      "prefill": true
    },
    "url": "full"
  },
