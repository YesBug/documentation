              {
                "group": "Integration and production",
                "pages": [
                  "en/guides/protocols",
                  "en/guides/migration",
                  "en/guides/production",
                  "en/guides/async-tasks"
                ]
              },
              {
                "group": "Images, video and music",
                "pages": [
                  "en/media/index",
                  "en/media/image-providers",
                  "en/media/videos",
                  "en/media/video-providers",
                  "en/media/midjourney",
                  "en/media/music"
                ]
              },
              {
                "group": "Help and support",
                "pages": [
                  "en/help/errors",
                  "en/help/faq"
                ]
              }
            ]
          },
