{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "MaxAPI",
  "description": "MaxAPI developer documentation: API reference, integration guides, and interactive examples in English and Chinese.",
  "colors": {
    "primary": "#2563EB",
    "light": "#60A5FA",
    "dark": "#1D4ED8"
  },
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg"
  },
  "favicon": "/images/favicon.svg",
  "appearance": {
    "default": "light"
  },
  "navigation": {
    "languages": [
      {
        "language": "zh",
        "default": true,
        "navbar": {
          "links": [
            {
              "label": "官网",
              "href": "https://maxapi.ai"
            }
          ],
          "primary": {
            "type": "button",
            "label": "控制台",
            "href": "https://platform.maxapi.ai"
          }
        },
        "tabs": [
          {
            "tab": "开发指南",
            "icon": "book-open",
            "groups": [
              {
                "group": "开始使用",
                "pages": [
                  "zh/index",
                  "zh/quickstart",
                  "zh/authentication",
                  "zh/models"
                ]
              },
              {
                "group": "开发接入",
                "pages": [
                  "zh/guides/text-generation",
                  "zh/guides/python",
                  "zh/guides/nodejs",
                  "zh/guides/streaming",
                  "zh/guides/vision",
                  "zh/guides/tools"
                ]
              },
              {
                "group": "集成与上线",
                "pages": [
                  "zh/guides/protocols",
                  "zh/guides/migration",
                  "zh/guides/production",
                  "zh/guides/async-tasks"
                ]
              },
              {
                "group": "图像、视频与音乐",
                "pages": [
                  "zh/media/index",
                  "zh/media/image-providers",
                  "zh/media/videos",
                  "zh/media/video-providers",
                  "zh/media/midjourney",
                  "zh/media/music"
                ]
              },
              {
                "group": "帮助与支持",
                "pages": [
                  "zh/help/errors",
                  "zh/help/faq"
                ]
              }
            ]
          },
          {
            "tab": "API 参考",
            "icon": "code",
            "groups": [
              {
                "group": "接口接入",
                "pages": [
                  "zh/api-reference/index",
                  "zh/playground"
                ]
              },
              {
                "group": "文本",
                "pages": [
                  "zh/api-reference/chat-completions",
                  "zh/api-reference/completions",
                  "zh/api-reference/embeddings"
                ]
              },
              {
                "group": "图像",
                "pages": [
                  "zh/api-reference/images",
                  "zh/api-reference/images-edits"
                ]
              },
              {
                "group": "音频",
                "pages": [
                  "zh/api-reference/audio-speech",
                  "zh/api-reference/audio-transcriptions",
                  "zh/api-reference/audio-translations"
                ]
              },
              {
                "group": "模型与扩展",
                "pages": [
                  "zh/api-reference/models",
                  "zh/api-reference/catalog"
                ]
              }
            ]
          }
        ]
      },
      {
        "language": "en",
        "default": false,
        "navbar": {
          "links": [
            {
              "label": "Website",
              "href": "https://maxapi.ai"
            }
          ],
          "primary": {
            "type": "button",
            "label": "Console",
