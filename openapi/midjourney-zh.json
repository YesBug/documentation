          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "错误体由网关或渠道返回，保留原始响应用于排错；不假定统一字段。",
        "additionalProperties": true
      },
      "TaskQueryRequest": {
        "type": "object",
        "properties": {
          "pageNumber": {
            "type": "integer",
            "description": "页码，从 0 开始。",
            "format": "int32",
