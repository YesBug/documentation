    "/mj/submit/blend": {
      "post": {
        "operationId": "submitMidjourneyBlend",
        "summary": "提交 Blend 混图",
        "description": "把多张图片以 Base64 Data URI 数组提交，混合生成新图片。请求是 JSON，不是 multipart 文件上传。",
