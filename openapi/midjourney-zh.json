            "example": "https://example.com/webhooks/midjourney"
          },
          "state": {
            "type": "string",
            "description": "自定义业务关联值，查询任务时在 state 中返回。不要放入密钥或敏感信息。",
            "example": "illustration-job-001"
          }
        },
        "required": [
          "base64Array"
        ]
      },
      "DescribeRequest": {
        "type": "object",
        "properties": {
          "base64": {
            "type": "string",
            "description": "图片的 Base64 Data URI，例如 data:image/png;base64,...。把示例占位符替换为完整图片内容。",
            "example": "data:image/png;base64,REPLACE_WITH_BASE64"
          },
          "botType": {
            "type": "string",
            "description": "机器人类型。Midjourney 使用 MID_JOURNEY，Niji 使用 NIJI_JOURNEY；是否可用取决于当前渠道。",
            "enum": [
              "MID_JOURNEY",
              "NIJI_JOURNEY"
            ]
          },
          "accountFilter": {
            "$ref": "#/components/schemas/AccountFilter"
          },
          "notifyHook": {
            "type": "string",
            "description": "任务状态或进度变化的回调地址。不传时使用服务端已配置的回调地址（如有）；两者都为空则不发送回调。",
            "example": "https://example.com/webhooks/midjourney"
          },
          "state": {
            "type": "string",
            "description": "自定义业务关联值，查询任务时在 state 中返回。不要放入密钥或敏感信息。",
            "example": "illustration-job-001"
          }
        },
        "required": [
          "base64"
        ]
      },
      "ShortenRequest": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "绘图或文本分析提示词。模型参数写在提示词中，按所选模型支持的语法使用。",
            "example": "A small observatory on a green hill, watercolor illustration"
          },
          "botType": {
            "type": "string",
            "description": "机器人类型。Midjourney 使用 MID_JOURNEY，Niji 使用 NIJI_JOURNEY；是否可用取决于当前渠道。",
            "enum": [
              "MID_JOURNEY",
              "NIJI_JOURNEY"
            ]
          },
          "accountFilter": {
            "$ref": "#/components/schemas/AccountFilter"
          },
          "notifyHook": {
            "type": "string",
            "description": "任务状态或进度变化的回调地址。不传时使用服务端已配置的回调地址（如有）；两者都为空则不发送回调。",
            "example": "https://example.com/webhooks/midjourney"
          },
          "state": {
            "type": "string",
            "description": "自定义业务关联值，查询任务时在 state 中返回。不要放入密钥或敏感信息。",
            "example": "illustration-job-001"
          }
        },
        "required": [
          "prompt"
        ]
      },
      "TaskIdsRequest": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "description": "需要查询的任务 ID 列表。按返回对象的 id 匹配，不依赖数组顺序。",
            "items": {
              "type": "string",
              "description": "任务 ID。使用提交响应中的 result 或查询响应中的 id；保持为字符串。",
              "example": "YOUR_TASK_ID"
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "提交业务码：1 表示已提交，22 表示已进入队列。21 必须结合接口与任务状态处理：动作接口可表示窗口等待（MODAL），部分兼容版本表示任务已存在。其他值读取 description，不要视为生成成功。",
            "format": "int32"
          },
          "description": {
            "type": "string",
            "description": "本次提交结果的说明。"
          },
          "result": {
            "type": "string",
            "description": "本次提交关联的任务 ID。提交失败时不能仅凭此字段继续轮询。"
          },
          "properties": {
            "type": "object",
            "description": "附加提交信息，字段按实际响应处理。",
            "additionalProperties": true
          }
        },
        "required": [
          "code",
          "description"
        ]
      },
      "Button": {
        "type": "object",
        "properties": {
          "customId": {
            "type": "string",
            "description": "动作标识，提交 action 时原样使用。"
          },
          "emoji": {
            "type": "string",
            "description": "按钮图标。"
          },
          "label": {
            "type": "string",
            "description": "用于展示的按钮文字，不是 action 的动作标识。"
          },
          "style": {
            "type": "integer",
            "description": "按钮样式；资料中 2 为 Primary、3 为 Green。",
            "format": "int32"
          },
          "type": {
            "type": "integer",
            "description": "按钮类型，通常仅供展示组件使用。",
            "format": "int32"
          }
        }
      },
      "TaskProperties": {
        "type": "object",
        "properties": {
          "finalPrompt": {
            "type": "string",
            "description": "Describe 返回的图片描述，或 Shorten 返回的分析结果。内容可能包含 Markdown 或多段文字，按字符串处理。"
          },
          "finalZhPrompt": {
            "type": "string",
            "description": "可选的中文翻译结果，不保证每次返回。"
          }
        },
        "additionalProperties": true
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "任务 ID。",
            "example": "YOUR_TASK_ID"
          },
          "action": {
            "type": "string",
            "description": "任务类型，例如 IMAGINE、UPSCALE、VARIATION、REROLL、ZOOM、PAN、DESCRIBE、BLEND、SHORTEN。不同版本可能增加类型。"
          },
          "status": {
            "type": "string",
            "description": "任务状态：NOT_START 未启动；SUBMITTED 已提交；MODAL 等待补充输入；IN_PROGRESS 执行中；SUCCESS 成功；FAILURE 失败；CANCEL 已取消。MODAL 需要提交 modal，不应只继续轮询。"
          },
          "prompt": {
            "type": "string",
            "description": "原始提示词。"
          },
          "promptEn": {
            "type": "string",
            "description": "英文提示词。"
          },
          "description": {
            "type": "string",
            "description": "任务的描述信息。"
          },
          "submitTime": {
            "type": "integer",
            "description": "任务提交时间。",
            "format": "int64"
          },
          "startTime": {
            "type": "integer",
            "description": "任务开始执行时间。",
            "format": "int64"
          },
          "finishTime": {
            "type": "integer",
            "description": "任务结束时间。",
            "format": "int64"
          },
          "progress": {
            "type": "string",
            "description": "任务进度的显示文本，例如 100%。判断结束应读取 status。"
          },
          "imageUrl": {
            "type": "string",
            "description": "图片地址，执行中可能是预览图；最终下载前确认 status 为 SUCCESS。Describe 和 Shorten 应同时读取 properties 中的文本结果。"
          },
          "failReason": {
            "type": [
              "string",
              "null"
            ],
            "description": "失败原因，未失败时可能为空或缺失。"
          },
          "state": {
            "type": "string",
            "description": "提交时提供的业务关联值。"
          },
          "properties": {
            "$ref": "#/components/schemas/TaskProperties"
          },
          "buttons": {
            "type": "array",
            "description": "当前任务返回的可用按钮。对所选按钮提交 customId，并保留它所属的任务 ID。",
            "items": {
              "$ref": "#/components/schemas/Button"
            }
          }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "业务结果码。结合 description 与后续任务状态判断，不把 HTTP 200 等同于操作完成。",
            "format": "int32"
          },
          "description": {
            "type": "string",
            "description": "操作结果说明。"
          }
        }
      },
      "SeedResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "1 表示获取成功；其他值读取 description。",
            "format": "int32"
          },
          "description": {
            "type": "string",
            "description": "获取结果说明。"
          },
          "result": {
