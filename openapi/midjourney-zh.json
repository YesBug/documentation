    "/mj/task/{id}/fetch": {
      "get": {
        "operationId": "fetchMidjourneyTask",
        "summary": "查询单个任务",
        "description": "返回任务对象本身。根据 status 区分等待、补充输入、成功、失败与取消；成功后读取图片或文本结果，再展示 buttons 中的可用动作。",
        "tags": [
          "Midjourney 任务管理"
        ],
        "responses": {
          "200": {
            "description": "请求结果。请同时检查业务码与任务状态。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                },
                "examples": {
                  "success": {
                    "summary": "已完成的绘图任务",
                    "value": {
                      "id": "YOUR_TASK_ID",
                      "action": "IMAGINE",
                      "status": "SUCCESS",
                      "progress": "100%",
                      "prompt": "A small observatory on a green hill, watercolor illustration",
                      "imageUrl": "https://example.com/generated-image.png",
                      "buttons": [
                        {
                          "customId": "COPY_FROM_TASK_BUTTONS",
                          "label": "U1",
                          "emoji": "",
                          "style": 2,
                          "type": 2
                        }
                      ],
                      "state": "illustration-job-001"
                    }
                  },
                  "modal": {
                    "summary": "等待补充输入的任务",
                    "value": {
                      "id": "YOUR_PENDING_TASK_ID",
                      "status": "MODAL"
                    }
                  },
                  "text": {
                    "summary": "Describe 文本结果",
                    "value": {
                      "id": "YOUR_TASK_ID",
                      "action": "DESCRIBE",
                      "status": "SUCCESS",
                      "properties": {
                        "finalPrompt": "A small observatory on a green hill, watercolor illustration"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "身份验证失败。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "请求被拒绝。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "请求资源未找到。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "需要查询或操作的任务 ID。",
            "schema": {
              "type": "string",
              "example": "YOUR_TASK_ID"
            }
          }
        ]
      }
    },
