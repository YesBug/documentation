    "/mj/task/{id}/image-seed": {
      "get": {
        "operationId": "getMidjourneyImageSeed",
        "summary": "获取图片 Seed",
        "description": "获取已生成图片的 seed。code 为 1 时 result 是 seed 字符串，不是新任务 ID。此功能依赖渠道已配置相应机器人的私信能力。",
        "tags": [
          "Midjourney 任务管理"
        ],
        "responses": {
          "200": {
            "description": "请求结果。请同时检查业务码与任务状态。",
            "content": {
              "application/json": {
