  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "在控制台创建 API Key，并作为 Authorization: Bearer <API_KEY> 发送。"
      }
    },
    "schemas": {
      "AccountFilter": {
        "type": "object",
        "properties": {
          "instanceId": {
            "type": "string",
            "description": "指定账号实例 ID。仅在已明确获知可用实例时填写。"
          },
          "modes": {
            "type": "array",
            "description": "按账号模式筛选。它不替代请求 URL 的模式前缀。",
            "items": {
              "type": "string",
              "description": "账号运行模式。",
              "enum": [
                "RELAX",
                "FAST",
                "TURBO"
              ]
            }
          },
          "remix": {
            "type": "boolean",
            "description": "按账号是否启用 Remix 筛选。"
          },
          "remixAutoConsidered": {
            "type": "boolean",
            "description": "筛选时是否把启用 Remix 自动提交的账号视为 remix 为 false。"
          }
        },
        "description": "可选账号筛选条件。普通接入通常可以省略，由服务端选择可用账号。"
      },
      "ImagineRequest": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "绘图或文本分析提示词。模型参数写在提示词中，按所选模型支持的语法使用。",
            "example": "A small observatory on a green hill, watercolor illustration"
          },
          "base64Array": {
            "type": "array",
            "description": "参考图片的 Base64 Data URI 数组；纯文生图时省略。",
            "items": {
              "type": "string",
              "description": "图片的 Base64 Data URI，例如 data:image/png;base64,...。把示例占位符替换为完整图片内容。",
              "example": "data:image/png;base64,REPLACE_WITH_BASE64"
            }
          },
          "botType": {
            "type": "string",
            "description": "机器人类型。Midjourney 使用 MID_JOURNEY，Niji 使用 NIJI_JOURNEY；是否可用取决于当前渠道。",
            "enum": [
              "MID_JOURNEY",
              "NIJI_JOURNEY"
            ]
          },
          "accountFilter": {
            "$ref": "#/components/schemas/AccountFilter"
          },
          "notifyHook": {
            "type": "string",
            "description": "任务状态或进度变化的回调地址。不传时使用服务端已配置的回调地址（如有）；两者都为空则不发送回调。",
            "example": "https://example.com/webhooks/midjourney"
          },
          "state": {
            "type": "string",
            "description": "自定义业务关联值，查询任务时在 state 中返回。不要放入密钥或敏感信息。",
            "example": "illustration-job-001"
          }
        },
        "required": [
          "prompt"
        ]
      },
      "ActionRequest": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "description": "任务 ID。使用提交响应中的 result 或查询响应中的 id；保持为字符串。",
            "example": "YOUR_TASK_ID"
          },
          "customId": {
            "type": "string",
            "description": "从该任务 buttons 中读取并原样提交的动作标识。不能只发送 U1、V1 等按钮文字，也不要拼接标识。",
            "example": "COPY_FROM_TASK_BUTTONS"
          },
          "notifyHook": {
            "type": "string",
            "description": "任务状态或进度变化的回调地址。不传时使用服务端已配置的回调地址（如有）；两者都为空则不发送回调。",
            "example": "https://example.com/webhooks/midjourney"
          },
          "state": {
            "type": "string",
            "description": "自定义业务关联值，查询任务时在 state 中返回。不要放入密钥或敏感信息。",
            "example": "illustration-job-001"
          }
        },
        "required": [
          "customId",
          "taskId"
        ]
      },
      "ModalRequest": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
