              "MODAL",
              "IN_PROGRESS",
              "FAILURE",
              "SUCCESS",
              "CANCEL"
            ]
          },
          "statusSet": {
            "type": "array",
            "description": "按多个任务状态筛选。",
            "items": {
              "type": "string",
              "description": "任务状态。",
              "enum": [
                "NOT_START",
                "SUBMITTED",
                "MODAL",
                "IN_PROGRESS",
                "FAILURE",
                "SUCCESS",
                "CANCEL"
              ]
            }
          }
        }
      },
      "Sort": {
        "type": "object",
        "properties": {
          "empty": {
            "type": "boolean",
            "description": "是否没有排序条件。"
          },
          "sorted": {
            "type": "boolean",
            "description": "是否已指定排序。"
          },
          "unsorted": {
            "type": "boolean",
            "description": "是否未指定排序。"
          }
        }
      },
      "Pageable": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "description": "分页偏移量。",
            "format": "int64"
          },
          "pageNumber": {
            "type": "integer",
            "description": "当前页码。",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "description": "每页条数。",
            "format": "int32"
          },
          "paged": {
            "type": "boolean",
            "description": "是否使用分页。"
          },
          "sort": {
            "$ref": "#/components/schemas/Sort"
          },
          "unpaged": {
            "type": "boolean",
            "description": "是否不使用分页。"
          }
        }
      },
      "TaskPage": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "description": "当前页的任务。",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "empty": {
            "type": "boolean",
            "description": "当前页是否为空。"
          },
          "first": {
            "type": "boolean",
            "description": "是否为第一页。"
          },
          "last": {
            "type": "boolean",
            "description": "是否为最后一页。"
          },
          "number": {
            "type": "integer",
            "description": "当前页码，从 0 开始。",
            "format": "int32"
          },
          "numberOfElements": {
            "type": "integer",
            "description": "当前页实际条数。",
            "format": "int32"
          },
          "pageable": {
            "$ref": "#/components/schemas/Pageable"
          },
          "size": {
            "type": "integer",
            "description": "分页大小。",
            "format": "int32"
          },
          "sort": {
            "$ref": "#/components/schemas/Sort"
          },
          "totalElements": {
            "type": "integer",
            "description": "符合条件的总条数。",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "description": "总页数。",
            "format": "int32"
          }
        }
      }
    }
  }
}
