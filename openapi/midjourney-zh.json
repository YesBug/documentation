{
  "openapi": "3.1.0",
  "info": {
    "title": "MaxAPI Midjourney API",
    "version": "1.0.0",
    "description": "Midjourney 绘图、交互动作与任务管理接口。请求使用 MaxAPI Bearer API Key。默认示例使用 /mj 路径；为同一任务保持一致的模式前缀。请求与响应示例仅展示结构，任务 ID、动作标识和图片内容必须来自你的实际调用。"
  },
  "servers": [
    {
      "url": "https://api.maxapi.ai",
      "description": "Fast：默认示例使用 /mj。请选择当前账户已开通的模式。"
    },
    {
      "url": "https://api.maxapi.ai/mj-turbo",
      "description": "Turbo：生成路径 /mj-turbo/mj/...，需要账户已开通 Turbo。"
    },
    {
      "url": "https://api.maxapi.ai/mj-relax",
      "description": "Relax：生成路径 /mj-relax/mj/...，需要账户已开通 Relax。"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Midjourney 任务提交"
    },
    {
      "name": "Midjourney 任务管理"
    }
  ],
  "paths": {
    "/mj/submit/imagine": {
      "post": {
        "operationId": "submitMidjourneyImagine",
        "summary": "提交 Imagine 绘图",
        "description": "根据提示词创建绘图任务。保存 result，再查询任务；提交响应不包含最终生成图片。",
        "tags": [
          "Midjourney 任务提交"
        ],
        "responses": {
          "200": {
            "description": "请求结果。请同时检查业务码与任务状态。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                },
                "examples": {
                  "accepted": {
                    "summary": "已提交",
                    "value": {
                      "code": 1,
                      "description": "提交成功",
                      "result": "YOUR_TASK_ID"
                    }
                  },
                  "queued": {
                    "summary": "已进入队列",
                    "value": {
                      "code": 22,
                      "description": "排队中",
                      "result": "YOUR_TASK_ID"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "身份验证失败。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "请求被拒绝。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "请求资源未找到。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImagineRequest"
              },
              "example": {
                "prompt": "A small observatory on a green hill, watercolor illustration",
                "state": "illustration-job-001"
              }
            }
          },
          "required": true
        }
      }
    },
    "/mj/submit/action": {
      "post": {
        "operationId": "submitMidjourneyAction",
        "summary": "执行任务按钮动作",
        "description": "使用原任务 id 与其 buttons 中的 customId 执行放大、变化等动作。code 为 21 且表示窗口等待时，result 是待确认任务 ID；确认 MODAL 状态后调用 modal。code 为 1 或 22 时跟踪返回的任务 ID。",
        "tags": [
          "Midjourney 任务提交"
        ],
        "responses": {
          "200": {
            "description": "请求结果。请同时检查业务码与任务状态。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                },
                "examples": {
                  "accepted": {
                    "summary": "已提交",
                    "value": {
                      "code": 1,
                      "description": "提交成功",
                      "result": "YOUR_TASK_ID"
                    }
                  },
                  "queued": {
                    "summary": "已进入队列",
                    "value": {
                      "code": 22,
                      "description": "排队中",
                      "result": "YOUR_TASK_ID"
                    }
                  },
                  "modal": {
                    "summary": "等待补充输入",
                    "value": {
                      "code": 21,
                      "description": "窗口等待",
                      "result": "YOUR_PENDING_TASK_ID"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "身份验证失败。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "请求被拒绝。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "请求资源未找到。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActionRequest"
              },
              "example": {
                "taskId": "YOUR_TASK_ID",
                "customId": "COPY_FROM_TASK_BUTTONS"
              }
            }
          },
          "required": true
        }
      }
    },
    "/mj/submit/modal": {
      "post": {
        "operationId": "submitMidjourneyModal",
        "summary": "提交 Modal 补充输入",
        "description": "为等待交互确认的任务提交最终提示词或蒙版。taskId 使用待确认任务的 ID，不能默认使用原始图片任务 ID。完成提交后，跟踪返回的 result。",
