              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                },
                "examples": {
                  "accepted": {
                    "summary": "已提交",
                    "value": {
                      "code": 1,
                      "description": "提交成功",
                      "result": "YOUR_TASK_ID"
                    }
                  },
                  "queued": {
                    "summary": "已进入队列",
                    "value": {
                      "code": 22,
                      "description": "排队中",
                      "result": "YOUR_TASK_ID"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "身份验证失败。",
