          },
          "pageSize": {
            "type": "integer",
            "description": "每页条数。示例值不是服务端默认值或最大值。",
            "format": "int32",
            "example": 20
          },
          "sort": {
            "type": "string",
            "description": "排序表达式。只使用当前渠道已确认支持的格式。"
          },
          "action": {
            "type": "string",
            "description": "按任务类型筛选。",
            "enum": [
              "IMAGINE",
              "UPSCALE",
              "VARIATION",
              "ZOOM",
              "PAN",
              "DESCRIBE",
              "BLEND",
              "SHORTEN",
              "SWAP_FACE"
            ]
          },
          "description": {
            "type": "string",
            "description": "按任务描述筛选。"
          },
          "ids": {
            "type": "array",
            "description": "按任务 ID 列表筛选。",
            "items": {
              "type": "string",
              "description": "任务 ID。使用提交响应中的 result 或查询响应中的 id；保持为字符串。",
              "example": "YOUR_TASK_ID"
            }
          },
          "instanceId": {
            "type": "string",
            "description": "按账号实例 ID 筛选。"
          },
